{
  "name": "conduit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A low-code workflow builder: compose typed nodes on a canvas, validate the graph, and run it with parallel, cancellable, branch-aware execution.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "jsdom": "^31.0.0",
    "typescript": "^6.0.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.14"
  }
}
